# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application)
COMPANION_GOOGLE_CLIENT_ID=
COMPANION_GOOGLE_CLIENT_SECRET=
# The public HTTPS origin Google redirects back to, e.g. a cloudflared tunnel URL
COMPANION_PUBLIC_BASE_URL=
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COMPANION_TOKEN_ENCRYPTION_KEY=
# Shared secret the messaging bridge sends as X-Bridge-Secret
COMPANION_BRIDGE_SECRET=
COMPANION_ANTHROPIC_API_KEY=
